DATABASE_URL=postgresql://cutroom_app:local-app@127.0.0.1:55432/cutroom
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate with openssl rand -hex 32 before starting the API.
BETTER_AUTH_SECRET=
# Shared only with the private Codex runner. Generate another 32-byte secret.
CUTROOM_RUNNER_SECRET=
CUTROOM_RUNNER_URL=http://127.0.0.1:4200
# Per signed-in owner, per UTC day. Zero disables new turns or renders.
CUTROOM_DAILY_TURNS=30
CUTROOM_DAILY_RENDERS=100
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Cutroom <accounts@cutroom.test>
CUTROOM_MEDIA_STORAGE=local
# For hosted private media set CUTROOM_MEDIA_STORAGE=imagekit and supply all three keys.
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-account
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
