{
  "name": "video-editor",
  "private": true,
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @editor/web --filter @editor/api dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun --filter @editor/web --filter @editor/api start",
    "render": "bun run --cwd apps/worker render",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/bun": "1.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
